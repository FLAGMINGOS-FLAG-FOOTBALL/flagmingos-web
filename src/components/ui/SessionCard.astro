---
import CalendarCheck from '@lucide/astro/icons/calendar-check'
import Calendar from '@lucide/astro/icons/calendar'
import { formatDate, formatTime, formatDateDisplay, type Event } from '../../lib/calendar'

interface Props {
  session: Event
  class?: string
}

const { session: s, class: className = '' } = Astro.props

const badgeStyle = {
  adultes: 'border-line text-ink-soft',
  jeunes: 'border-brand-500 text-brand-500',
}

type BadgeStyleKey = keyof typeof badgeStyle
---

<label
  class:list={[
    'group border-line has-checked:border-brand-500 has-checked:bg-brand-50 flex items-center justify-between border-2 bg-white p-3.5 transition sm:p-5',
    className,
  ]}
>
  <input
    type="radio"
    name="session"
    class="peer sr-only"
    required
    value={formatDate(s.startDate)}
    data-start={s.startDate.toISOString()}
    data-end={s.endDate.toISOString()}
    data-location={s.location ?? ''}
    data-summary={s.summary ?? ''}
  />

  <div>
    <span
      class={`${badgeStyle[(s.type?.toLowerCase() as BadgeStyleKey) || 'adultes']} mb-1.5 inline-block border px-1.5 py-0.5 text-[10px] tracking-wider uppercase sm:mb-2`}
    >
      {
        s.type?.toLowerCase() == 'jeunes' ? (
          <>
            Jeunes - <b class="font-extrabold">{s.format}</b>
          </>
        ) : (
          'Adultes'
        )
      }
    </span>
    <p class="text-ink font-semibold">{formatDateDisplay(s.startDate)}</p>
    <p class="text-ink-soft mt-1 font-mono text-sm sm:mt-2">
      {formatTime(s.startDate)} - {formatTime(s.endDate)}
    </p>
  </div>
  <Calendar class="text-line h-5 w-5 shrink-0 transition group-has-checked:hidden sm:h-6 sm:w-6" />
  <CalendarCheck
    class="text-line group-has-checked:text-brand-500 hidden h-5 w-5 shrink-0 transition group-has-checked:block sm:h-6 sm:w-6"
  />
</label>
